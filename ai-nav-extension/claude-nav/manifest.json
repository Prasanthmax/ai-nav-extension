{
  "manifest_version": 3,
  "name": "Claude Conversation Navigator",
  "short_name": "Claude Nav",
  "version": "1.2.0",
  "description": "Jump to any message instantly. Adds a sidebar navigator to Claude.ai so you never lose your place in long conversations.",
  "permissions": [],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude Conversation Navigator"
  }
}
